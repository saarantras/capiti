# OXA-48 poster figure: 15 ProteinMPNN designs (ESMFold) overlaid on WT.
# Run via scripts/render_oxa48.sh (sets $D and opens structures in order:
#   #1 experimental chain A, #2 ESMFold WT, #3-17 the 15 design folds).

# superpose every model onto the experimental OXA-48 structure (#1);
# matchmaker prints per-model RMSD to the log
matchmaker #2-17 to #1

# global look
set bgColor white
lighting soft
graphics silhouettes true
hide atoms
dssp #1-17                 ;# reassign secondary structure for crisp cartoon
show cartoon
hide #1 models             ;# experimental ref is the alignment anchor only

# 15 designs: thin, red, translucent ghosts
color #3-17 red
cartoon style #3-17 thickness 0.4 width 1.0
transparency #3-17 60 target c

# wild-type: opaque, solid colour, slightly bolder ribbon
color #2 purple
cartoon style #2 thickness 0.7 width 1.6
transparency #2 0 target c

# frame on the visible models only, then fill the canvas
view #2-17
zoom 1.3

# main view plus two rotations so the fold is legible from several angles
save SAVE_PATH width 3200 height 2600 supersample 3
turn y 90
save SAVE_PATH_y90 width 3200 height 2600 supersample 3
turn y 90
turn x 90
save SAVE_PATH_top width 3200 height 2600 supersample 3
exit
